# ---- Node / frontend --------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# ---- Python / backend -------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Environment and secrets ------------------------------------------------
# .env.example is committed on purpose, everything else with real values is not.
.env
.env.*
!.env.example

# ---- Docker and data --------------------------------------------------------
# Postgres lives in the named `pgdata` volume, but catch bind-mounted copies too.
pgdata/
*.sqlite3
# Local-only compose tweaks: ports, mounts, an override of the seeded data.
docker-compose.override.yml
# .dockerignore and Dockerfile are committed on purpose; both are part of the build.

# ---- Deploy tooling ---------------------------------------------------------
# Left behind by the Vercel CLI. The project is hosted with Docker instead.
.vercel/

# ---- Editors and OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
# Shared: pins the editor to the project's TypeScript so everyone sees the same
# errors as the CLI.
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude Code ------------------------------------------------------------
.claude/settings.local.json
